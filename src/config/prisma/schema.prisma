model StockMovement {
  id        Int          @id @default(autoincrement())
  productId Int
  // Cantidad que se movió (ej: +10 o -5)
  quantity  Int
  // Útil para saber por qué cambió (Venta, Reabastecimiento, Merma, Devolución)
  type      MovementType
  createdAt DateTime     @default(now())
  product   Product      @relation(fields: [productId], references: [id])
}

// Enum para categorizar los movimientos
enum MovementType {
  IN // Entrada de proveedor
  OUT // Venta
  ADJUSTMENT // Corrección de inventario
  RETURN // Devolución de cliente
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contact     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true)
  brands      Brand[]
}

