model User {
  id            Int      @id @default(autoincrement())
  supertokensId String   @unique // vínculo con SuperTokens
  email         String?
  name          String?
  avatarUrl     String?
  role          UserRole @default(CONSUMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Ejemplo: si después quieres órdenes:
  // orders        Order[]
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CONSUMER
}

