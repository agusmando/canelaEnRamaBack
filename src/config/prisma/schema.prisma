// ./src/config/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // Si tienes previewFeatures raros, quítalos por ahora
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Puerto 6543 (Pooler)
  directUrl = env("DIRECT_URL") // Puerto 5432 (Directo)
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  active      Boolean @default(true)

  Category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  Brand      Brand    @relation(fields: [brandId], references: [id])
  brandId    Int
  Tags       Tag[]

  variants ProductVariant[]

  // Medidas (Esto define qué es físicamente)
  measure       MeasureType @relation(fields: [measureTypeId], references: [id])
  measureTypeId Int
  offers        Offer[]
  // Review      Review[]
  // offers      Offer[]
}

model ProductVariant {
  id        Int @id @default(autoincrement())
  productId Int

  // Atributos
  name           String      @default("default")
  price          Float
  profitMargin   Float       @default(0)
  currentStock   Int         @default(0)
  active         Boolean     @default(true) // Apaga solo esta presentación
  contentMeasure MeasureType @relation(fields: [measureTypeId], references: [id]) // Por ejemplo un frasco de 60cc, 150ml, 360g, etc
  contentAmount  Int         @default(0) // Por ejemplo un frasco de 60cc, 150ml, 360g, etc

  requestTime String @default("")

  // Relación con el padre
  product       Product      @relation(fields: [productId], references: [id])
  // Soy componente de:
  isComponentOf Dependency[] @relation("ComponentVariant")

  // Tengo componentes (si soy un Mix):
  hasComponents Dependency[] @relation("MixVariant")

  movements     StockMovement[]
  // OrderDetail  OrderDetail[]
  measureTypeId Int
  offers        Offer[]
  images        Image[]

  CartItem   CartItem[]
  orderItems OrderItem[]

  availableWeb       Boolean @default(true)
  availablePedidosYa Boolean @default(true)
}

model MeasureType {
  id              Int              @id @default(autoincrement())
  name            String
  products        Product[]
  productVariants ProductVariant[]
}

model Dependency {
  mixVariantId     Int
  productVariantId Int
  quantity         Float // Cantidad de cada componente por mix
  active           Boolean @default(true)

  // El producto que es el Mix/Combo
  mixVariant       ProductVariant @relation("MixVariant", fields: [mixVariantId], references: [id])
  // El producto que es el Componente
  componentProduct ProductVariant @relation("ComponentVariant", fields: [productVariantId], references: [id])

  @@id([mixVariantId, productVariantId])
}

model Brand {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  // Many-to-many: suppliers <-> brands
  suppliers Supplier[]

  // One-to-many: brand -> products
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
  active      Boolean   @default(true)
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
  active   Boolean   @default(true)
}

model StockMovement {
  id               Int             @id @default(autoincrement())
  productVariantId Int
  // Cantidad que se movió (ej: +10 o -5)
  quantity         Int
  priceAtTime      Float           @default(0)
  // Útil para saber por qué cambió (Venta, Reabastecimiento, Merma, Devolución)
  type             MovementType
  createdAt        DateTime        @default(now())
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
}

// Enum para categorizar los movimientos
enum MovementType {
  IN // Entrada de proveedor
  OUT // Venta
  ADJUSTMENT // Corrección de inventario
  RETURN // Devolución de cliente
  PRODUCTION // Reabastecimiento
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contact     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true)
  brands      Brand[]
}

model Offer {
  id               Int             @id @default(autoincrement())
  productVariantId Int?
  ProductVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  productId        Int?
  Product          Product?        @relation(fields: [productId], references: [id])
  startTime        DateTime
  finishTime       DateTime
  discountValue    Float? // (El porcentaje o el valor del descuento)
  discountType     DiscountType
  discountQuantity Int? // (La cantidad de productos que tienen que comprar para obtener el descuento)
  quantityToGet    Int? // (la cantidad total de items que se lleva el cliente, o la cantidad gratis)
  stockThreshold   Int? // (La cantidad mínima de stock necesaria para que la oferta sea válida)
  active           Boolean         @default(true)
}

enum DiscountType {
  PERCENTAGE // Descuento porcentual (0.1 = 10%)
  FIXED // Descuento fijo (10 = -$10)
  BUY_ONE_GET_MORE // Compra un producto y obtienes otro gratis (usa discountQuantity para saber la cantidad mínima que tiene que comprar para obtenerlo)
  BUY_MORE_GET_MORE // Compra muchos producto y obtienes una cantidad gratis (usa discountQuantity para saber la cantidad mínima que tiene que comprar para obtenerlo, quantityToGet te diría cuántos gratis)
  BUY_MORE_GET_DISCOUNT // Compra un producto y obtienes un descuento (usa discountQuantity igual, pero usa discountValue para saber el porcentaje de descuento)
  BUY_MORE_GET_FIXED_DISCOUNT // Compra un producto y obtienes un descuento fijo (usa discountQuantity igual, pero usa discountValue para saber el descuento fijo)
}

