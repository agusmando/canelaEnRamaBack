// ./src/config/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // Si tienes previewFeatures raros, quítalos por ahora
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Puerto 6543 (Pooler)
  directUrl = env("DIRECT_URL") // Puerto 5432 (Directo)
}

model Product {
  id            Int         @id @default(autoincrement())
  name          String
  description   String?
  price         Float
  active        Boolean     @default(true)
  currentStock  Int         @default(0)
  profitMargin  Float       @default(0.45)
  measure       MeasureType
  contentAmount Int         @default(0) // Por ejemplo un frasco de 60cc, 150ml, 360g, etc
  onRequest     Boolean     @default(false) // Si el producto se trae por encargo
  requestTime   String      @default("") // Fecha estimada de entrega

  Category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  // Review      Review[]

  Brand   Brand @relation(fields: [brandId], references: [id])
  brandId Int

  movements   StockMovement[]
  // CartItem    CartItem[]
  Tags        Tag[]
  OrderDetail OrderDetail[]
}

enum MeasureType {
  KG // Kilogramo
  U // Unidad
  L // Litro
  ML // Mililitro
  G // Gramo
  CC // Centímetro cuadrado
}

model Brand {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  // Many-to-many: suppliers <-> brands
  suppliers Supplier[]

  // One-to-many: brand -> products
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)
}

model Order {
  id         Int           @id @default(autoincrement())
  createdAt  DateTime      @default(now())
  totalPrice Float
  details    OrderDetail[]
}

model OrderDetail {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Float
  subtotal  Float

  Order   Order   @relation(fields: [orderId], references: [id])
  Product Product @relation(fields: [productId], references: [id])
}

