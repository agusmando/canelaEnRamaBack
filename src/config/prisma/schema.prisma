model Brand {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  // Many-to-many: suppliers <-> brands
  suppliers Supplier[]

  // One-to-many: brand -> products
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
  active      Boolean   @default(true)
  // offers      Offer[]
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
  active   Boolean   @default(true)
}

model StockMovement {
  id               Int             @id @default(autoincrement())
  productVariantId Int
  // Cantidad que se movió (ej: +10 o -5)
  quantity         Int
  // Útil para saber por qué cambió (Venta, Reabastecimiento, Merma, Devolución)
  type             MovementType
  createdAt        DateTime        @default(now())
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
}

// Enum para categorizar los movimientos
enum MovementType {
  IN // Entrada de proveedor
  OUT // Venta
  ADJUSTMENT // Corrección de inventario
  RETURN // Devolución de cliente
  PRODUCTION // Reabastecimiento
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contact     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true)
  brands      Brand[]
}

