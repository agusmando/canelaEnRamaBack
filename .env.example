# Copiar a .env y completar. En Render estas variables se cargan en el dashboard (ver render.yaml).

PORT=8080

# ---------------------------------------------------------------- Base de datos (Supabase)
# Pooler (puerto 6543) para la app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connect_timeout=60
# Conexión directa (puerto 5432) para migraciones
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Opcional: PRISMA_LOG=query,info,warn,error (por defecto warn,error)

# ---------------------------------------------------------------- Auth (SuperTokens)
# El login con Google (client id/secret) se configura en el core de SuperTokens.
SUPERTOKENS_CONNECTION_URI=
SUPERTOKENS_API_KEY=

# SMTP para el mail de "recuperar contraseña" (sin esto SuperTokens manda un mail genérico en inglés).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Canela en Rama
# URL del panel: aparece en el mail de invitación a usuarios del staff
DASHBOARD_URL=http://localhost:5174
API_DOMAIN=http://localhost:8080
WEBSITE_DOMAIN=http://localhost:5173

# Orígenes permitidos (coma separada). Vacío = refleja cualquier origen (solo desarrollo).
CORS_ORIGINS=

# ---------------------------------------------------------------- Imágenes (Cloudinary)
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------- Reseñas de Google (Places API New)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=Canela en Rama, Colombia 1268, Godoy Cruz, Mendoza
GOOGLE_PLACES_LANGUAGE=es

# ---------------------------------------------------------------- Mercado Pago (Checkout Pro)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL pública de la tienda (back_urls) y del backend sin /api (notification_url, https)
WEB_URL=http://localhost:5173
API_PUBLIC_URL=
MP_STATEMENT_DESCRIPTOR=CANELA EN RAMA
MP_ORDER_TTL_HOURS=48
MP_ALLOW_CASH=false

# Fotos de stock para scripts/seed-images.ts (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=

# ---------------------------------------------------------------- Envíos
# Origen de los envíos (el local). Lo usa Uber Direct para buscar el pedido.
SHIPPING_PICKUP_NAME=Canela en Rama
SHIPPING_PICKUP_STREET=Colombia 1268
SHIPPING_PICKUP_CITY=Godoy Cruz
SHIPPING_PICKUP_PROVINCE=Mendoza
SHIPPING_PICKUP_ZIP=5501
SHIPPING_PICKUP_PHONE=5492615790124

# Uber Direct (opcional). Sin estas variables se usa la tarifa propia por departamento
# (dashboard → Envíos → Tarifas). Credenciales en direct.uber.com → Developer.
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=

# Dashboard de SuperTokens (/api/auth/dashboard). Por defecto: prendido en desarrollo,
# apagado con NODE_ENV=production. "on" / "off" lo fuerza.
SUPERTOKENS_DASHBOARD=
# Emails que pueden modificar desde ese dashboard (coma separada). Vacío = todos.
SUPERTOKENS_DASHBOARD_ADMINS=

# Una sola cuenta por persona (email + Google con el mismo email, verificado).
# Requiere activar "Account Linking" en el core de supertokens.com ANTES de poner "on".
ACCOUNT_LINKING=

# Carritos de invitado abandonados: se borran los vacíos tras N días y los con productos tras M días.
# La limpieza corre solo en producción (o con CART_CLEANUP=on).
CART_EMPTY_TTL_DAYS=7
CART_GUEST_TTL_DAYS=30
CART_CLEANUP=
