model Brand {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  // Many-to-many: suppliers <-> brands
  suppliers Supplier[]

  // One-to-many: brand -> products
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]
  active      Boolean   @default(true)
  // offers      Offer[]
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
  active   Boolean   @default(true)
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  productId Int
  // Cantidad que se movió (ej: +10 o -5)
  quantity  Int
  // Útil para saber por qué cambió (Venta, Reabastecimiento, Merma, Devolución)
  type      MovementType
  createdAt DateTime     @default(now())
  product   Product      @relation(fields: [productId], references: [id])
}

// Enum para categorizar los movimientos
enum MovementType {
  IN // Entrada de proveedor
  OUT // Venta
  ADJUSTMENT // Corrección de inventario
  RETURN // Devolución de cliente
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contact     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true)
  brands      Brand[]
}

model Order {
  id         Int           @id @default(autoincrement())
  createdAt  DateTime      @default(now())
  totalPrice Float
  details    OrderDetail[]
}

model OrderDetail {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Float
  subtotal  Float

  Order   Order   @relation(fields: [orderId], references: [id])
  Product Product @relation(fields: [productId], references: [id])
}

model User {
  id            Int      @id @default(autoincrement())
  supertokensId String   @unique // vínculo con SuperTokens
  email         String?
  name          String?
  avatarUrl     String?
  role          UserRole @default(CONSUMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Ejemplo: si después quieres órdenes:
  // orders        Order[]
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CONSUMER
}

