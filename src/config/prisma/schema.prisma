// ./src/config/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  // Si tienes previewFeatures raros, quítalos por ahora
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Puerto 6543 (Pooler)
  directUrl = env("DIRECT_URL") // Puerto 5432 (Directo)
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  active      Boolean @default(true)

  Category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  Brand      Brand    @relation(fields: [brandId], references: [id])
  brandId    Int
  Tags       Tag[]

  variants ProductVariant[]

  // Medidas (Esto define qué es físicamente)
  measure       MeasureType @relation(fields: [measureTypeId], references: [id])
  measureTypeId Int
  // OrderDetail OrderDetail[]
  // Review      Review[]
  // CartItem    CartItem[]
  // offers      Offer[]
  // orderDetails OrderDetail[]
}

model ProductVariant {
  id        Int @id @default(autoincrement())
  productId Int

  // Atributos
  name           String      @default("default")
  price          Float
  profitMargin   Float       @default(0)
  currentStock   Int         @default(0)
  active         Boolean     @default(true) // Apaga solo esta presentación
  contentMeasure MeasureType @relation(fields: [measureTypeId], references: [id]) // Por ejemplo un frasco de 60cc, 150ml, 360g, etc
  contentAmount  Int         @default(0) // Por ejemplo un frasco de 60cc, 150ml, 360g, etc

  requestTime String @default("")

  // Relación con el padre
  product       Product      @relation(fields: [productId], references: [id])
  // Soy componente de:
  isComponentOf Dependency[] @relation("ComponentVariant")

  // Tengo componentes (si soy un Mix):
  hasComponents Dependency[] @relation("MixVariant")

  movements     StockMovement[]
  // OrderDetail  OrderDetail[]
  measureTypeId Int
}

model MeasureType {
  id              Int              @id @default(autoincrement())
  name            String
  products        Product[]
  productVariants ProductVariant[]
}

model Dependency {
  mixVariantId     Int
  productVariantId Int
  quantity         Float
  active           Boolean @default(true)

  // El producto que es el Mix/Combo
  mixVariant       ProductVariant @relation("MixVariant", fields: [mixVariantId], references: [id])
  // El producto que es el Componente
  componentProduct ProductVariant @relation("ComponentVariant", fields: [productVariantId], references: [id])

  @@id([mixVariantId, productVariantId])
}

