model Image {
  id               Int    @id @default(autoincrement())
  productVariantId Int
  public_id        String // Obligatorio: El ID que te dio Cloudinary (para borrar/editar).
  secure_url       String // La URL para mostrar la imagen en el frontend.
  ProductVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}
