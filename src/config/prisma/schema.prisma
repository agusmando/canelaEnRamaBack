model Image {
  id               Int            @id @default(autoincrement())
  productVariantId Int
  public_id        String // El ID de Cloudinary (para borrar/editar).
  secure_url       String // La URL para mostrar la imagen en el frontend.
  ProductVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
}

model User {
  id            Int      @id @default(autoincrement())
  supertokensId String   @unique // vínculo con SuperTokens
  email         String?
  name          String?
  avatarUrl     String?
  role          UserRole @default(CONSUMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cart          Cart?
  orders        Order[]

  // Ejemplo: si después quieres órdenes:
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CONSUMER
}

model Cart {
  id                Int        @id @default(autoincrement())
  userSuperTokensId String?    @unique
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  sessionId         String?    @unique // identificador de sesión para guests
  user              User?      @relation(fields: [userSuperTokensId], references: [supertokensId])
  items             CartItem[]
}

model CartItem {
  cartId           Int
  productVariantId Int
  quantity         Int
  createdAt        DateTime @default(now())

  cart           Cart           @relation(fields: [cartId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@id([cartId, productVariantId])
}

model Order {
  id                Int      @id @default(autoincrement())
  userSuperTokensId String
  user              User?    @relation(fields: [userSuperTokensId], references: [supertokensId])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  totalPrice  Float
  totalItems  Int
  paymentType String

  estimatedReadyAt DateTime? // Fecha estimada de entrega/retiro
  // Usar un Enum o mantener tu modelo OrderStatus
  status           OrderStatus @default(PENDING)
  orderItems       OrderItem[]
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id               Int  @id @default(autoincrement())
  orderId          Int
  productVariantId Int? 

  productNameSnapshot String // Ej: "Yogurt"
  variantNameSnapshot String // Ej: "Vainilla"
  unitPriceSnapshot   Float // El precio al que se vendió EXACTAMENTE ese día

  quantity        Int
  status          OrderItemStatus @default(FULFILLED)
  awaitingStockAt DateTime?
  selectedBulkOption Float?

  Order          Order           @relation(fields: [orderId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
}

enum OrderItemStatus {
  FULFILLED // Disponible y asignado
  AWAITING_STOCK // Sin stock, esperando reposición
  PARTIALLY_RETURNED // Parcialmente regresado
  CANCELLED // El cliente o el local lo quitaron
  RETURNED // El cliente lo regresa
}

